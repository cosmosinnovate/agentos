# =============================================================================
# AgentOS Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your chosen providers.
# All provider sections are optional — missing credentials auto-fall back to mock.
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# Database (required)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=agentos
DATABASE_USER=agentos
DATABASE_PASSWORD=agentos_secret

# =============================================================================
# MODEL PROVIDERS (configure any one or more)
# Set in agent YAML: spec.model.provider: openai | anthropic | vertex | bedrock | azure-openai | mock
# =============================================================================

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Vertex AI (GCP)
GCP_PROJECT_ID=
GCP_REGION=us-central1

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# =============================================================================
# DEPLOYMENT PROVIDERS (configure any one or more)
# Set in agent YAML: spec.deployment.provider: local | gcp | aws | azure
# =============================================================================

# GCP Cloud Run
# (uses GCP_PROJECT_ID and GCP_REGION from above)
AGENT_RUNTIME_IMAGE=gcr.io/agentos/runtime:latest
BACKEND_URL=http://localhost:3001

# AWS ECS Fargate
# (uses AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION from above)
AWS_ECS_CLUSTER=agentos-cluster

# Azure Container Apps
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=agentos-rg
AZURE_CONTAINER_ENV=agentos-env
AZURE_REGION=eastus
